generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // always stored lowercase
  name         String   @db.VarChar(80)
  passwordHash String
  role         Role     @default(USER)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links Link[]
}

model Link {
  id            String    @id @default(cuid())
  // Lowercase a-z, 0-9 and "-" — see src/lib/links.ts
  code          String    @unique @db.VarChar(50)
  url           String    @db.VarChar(2048)
  title         String?   @db.VarChar(120)
  userId        String
  // Owner can pause; admins can block (owner cannot undo a block)
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  blockedReason String?   @db.VarChar(200)
  expiresAt     DateTime?
  clickCount    Int       @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks Click[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

// One row per counted click. No IP address is stored.
model Click {
  id        BigInt   @id @default(autoincrement())
  linkId    String
  createdAt DateTime @default(now())
  country   String?  @db.VarChar(2) // ISO code from the CDN header, when present
  referrer  String?  @db.VarChar(255) // host only, e.g. "web.whatsapp.com"
  device    String   @db.VarChar(10) // mobile | tablet | desktop
  browser   String?  @db.VarChar(30)
  os        String?  @db.VarChar(30)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
}
