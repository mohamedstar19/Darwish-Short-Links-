# PostgreSQL connection (Neon, Supabase, Railway, or your own server)
DATABASE_URL="postgresql://user:password@localhost:5432/darwish_links?schema=public"

# Public base URL of this app — short links are built from it (no trailing slash)
APP_URL="https://drw.sh"

# Random secret, at least 32 characters: `openssl rand -base64 48`
SESSION_SECRET=""

# Optional: Google Safe Browsing API key — new links are checked against it
SAFE_BROWSING_API_KEY=""
